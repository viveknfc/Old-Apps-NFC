                                            <attributedString key="attributedText">
                                                <fragment content="Please note:">
                                                    <attributes>
                                                        <font key="NSFont" size="12" name="Helvetica-Bold"/>
                                                    </attributes>
                                                </fragment>
                                                <fragment>
                                                    <string key="content"> It is unlawful for an employee to be paid less than an employee of the opposite sex for equal work. Employers also may not prohibit employees from discussing wages with their co-workers.</string>
