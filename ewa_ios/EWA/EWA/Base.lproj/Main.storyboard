                                                    <rect key="frame" x="110" y="180" width="100" height="30"/>
                                                    <color key="backgroundColor" red="0.2666666667" green="0.61568627450000002" blue="0.2666666667" alpha="1" colorSpace="calibratedRGB"/>
                                                    <constraints>
                                                        <constraint firstAttribute="height" constant="30" id="8RH-2I-jNg"/>
                                                        <constraint firstAttribute="width" constant="100" id="xof-cN-M6i"/>
                                                    </constraints>
                                                    <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                                    <state key="normal" title="Press To Sign">
                                                        <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                    </state>
                                                    <connections>
                                                        <action selector="paidSickLeaveSign:" destination="OeG-uG-nZ5" eventType="touchUpInside" id="4LY-D5-L9n"/>
                                                    </connections>
                                                </button>
                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Qtl-fc-msP">
                                                    <rect key="frame" x="10" y="30" width="300" height="145"/>
                                                    <string key="text">I acknowledge reading and understanding all the instructions included in Paid Sick Leave FAQ and that I freely agree to accept and comply with them. I further acknowledge that I had the ability and opportunity to ask a TemPositions representative any questions I might have about these Paid Sick Leave FAQ before signing this form.

</string>
                                                    <fontDescription key="fontDescription" name="HelveticaNeue" family="Helvetica Neue" pointSize="12"/>
                                                    <nil key="textColor"/>
                                                    <nil key="highlightedColor"/>
                                                </label>
                                            </subviews>
