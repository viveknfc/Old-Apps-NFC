                            <constraints>
                                <constraint firstAttribute="height" constant="120" id="WzD-qH-bgQ"/>
                            </constraints>
                            <string key="text">In accordance with New Jersey State Department of Labor regulations, we are required to distribute annually the following notice for the “Conscientious Employee Protection Act.” Please read this and if you understand its provisions, check the box and sign your name, acknowledging that you have received and read this notice. If you have any questions, please do not hesitate to ask.</string>
