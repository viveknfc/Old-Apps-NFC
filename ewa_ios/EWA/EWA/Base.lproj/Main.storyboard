                                            <constraints>
                                                <constraint firstAttribute="height" constant="80" id="bYg-O3-Jwi"/>
                                            </constraints>
                                            <attributedString key="attributedText">
                                                <fragment content="8. Employee Acknowledgment:">
                                                    <attributes>
                                                        <font key="NSFont" size="12" name="Helvetica-Bold"/>
                                                    </attributes>
                                                </fragment>
                                                <fragment>
                                                    <string key="content">
On this day, I received notice of my pay rate, overtime rate (if eligible), allowances, and designated payday. I told my employer what my primary language is.</string>
                                                    <attributes>
                                                        <font key="NSFont" metaFont="cellTitle"/>
                                                    </attributes>
                                                </fragment>
                                            </attributedString>
